<?xml version="1.0" encoding="UTF-8"?>
<!-- Demo base routes for StoryZLine (the Reference Route File): invented, not a real application's. -->
<routes xmlns="http://camel.apache.org/schema/spring" xmlns:beans="http://www.springframework.org/schema/beans">

    <!-- Called as seda:audit.write: found by its <from uri>. -->
    <route id="audit.write">
        <from uri="seda:audit.write"/>
        <to uri="direct:base.mask"/>
        <to uri="bean:auditService?method=write"/>
    </route>

    <!-- Called as direct:base.mask: no <from uri> has that name, so it is found by its route id. -->
    <route id="base.mask">
        <from uri="direct:maskSensitiveFields"/>
        <setHeader name="masked">
            <constant>true</constant>
        </setHeader>
        <to uri="direct:common.trace"/>
    </route>

    <!-- Spring beans the routes use by name (bean:..., <process ref>): StoryZLine pulls their classes as Processors. -->
    <beans:bean id="paymentRequestCheck" class="com.base.processor.PaymentRequestCheck"/>
    <beans:bean id="validateSubmitProcessor" class="com.base.processor.ValidateSubmitProcessor"/>
    <beans:bean id="auditService" class="com.base.service.AuditService"/>
</routes>
