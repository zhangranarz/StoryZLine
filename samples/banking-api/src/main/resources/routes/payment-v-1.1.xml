<?xml version="1.0" encoding="UTF-8"?>
<!-- Demo Camel route file for StoryZLine (version 1.1 of the payment routes): invented, not a real application's. -->
<routes xmlns="http://camel.apache.org/schema/spring">

    <route id="payments.v1.submit">
        <from uri="direct:payments.v1_processSubmitApi"/>
        <setHeader name="apiVersion"><constant>1.1</constant></setHeader>
        <to uri="bean:validateSubmitProcessor"/>
        <to uri="bean:paymentController?method=processSubmitApi"/>
    </route>
</routes>
