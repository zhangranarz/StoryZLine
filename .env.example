# Copy to .env and fill in. .env is git-ignored: never commit your token.

# Bitbucket Server / Data Center: the URL you open in the browser (include any context path)
#   e.g. https://bitbucket.yourbank.com  or  https://git.yourbank.com/bitbucket
# Bitbucket Cloud: https://bitbucket.org
BITBUCKET_BASE_URL=

# Server/DC: an HTTP access token (Profile > Manage account > HTTP access tokens), read permission is enough.
# Cloud: a repository/workspace access token, or an API token together with BITBUCKET_USER.
BITBUCKET_TOKEN=

# Optional: set only for Basic auth (Cloud API token = your Atlassian email; Server = your username).
BITBUCKET_USER=

# Optional defaults so you can type a plain file path instead of a full Bitbucket URL.
BITBUCKET_PROJECT=
BITBUCKET_REPO=
BITBUCKET_BRANCH=

# Optional
PORT=5180
